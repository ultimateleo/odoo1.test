<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snk_site_tag_list_view" model="ir.ui.view">
            <field name="name">snk.site.tag.list.view</field>
            <field name="model">snk.site.tag</field>
            <field name="arch" type="xml">
                <list string="Site Tag" editable="bottom">
                    <field name="snk_name"/>
                    <field name="parent_id"/>
                </list>
            </field>
        </record>

         <record id="snk_site_tag_list_view_search" model="ir.ui.view">
            <field name="name">snk.site.tag.list.view</field>
            <field name="model">snk.site.tag</field>
            <field name="arch" type="xml">
                <search string="Site Tag">
                    <field name="snk_name"/>
                    <filter string="Name" name="snk_name" context="{'group_by':'snk_name'}"/>
                    <filter string="Parent" name="parent_id" context="{'group_by':'parent_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_snk_site_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">snk.site.tag</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="snk_site_tag_list_view"/>
        </record>

        <menuitem id="menu_snk_site_tag" name="Tags" parent="menu_snk_site_root" action="action_snk_site_tag" sequence="2"/>
        <!-- <record id="stock.menu_routes_config" model="ir.ui.menu">
            <field name="sequence">5</field>
            <field name="parent_id" ref="stock.menu_warehouse_config"/>
        </record> -->
    </data>
</odoo>
