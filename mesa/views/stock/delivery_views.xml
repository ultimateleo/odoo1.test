<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_withcarrier_out_form_inherit" model="ir.ui.view">
            <field name="name">delivery.stock.picking_withcarrier.form.view.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
            <field name="arch" type="xml">

                <field name="carrier_id" position="replace">
                    <field name="carrier_id" domain="['|', ('city_ids', 'in', city_id),('city_ids', '=', False)]"
                           string="Carrier" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="city_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <!-- Required by the modifiers below. Keep it in this inherited
                         view instead of relying on another view's load order. -->
                    <field name="snk_is_mutation" invisible="1"/>
                    <field name="delay_lead_time" readonly="state not in ['draft']" invisible="not snk_is_mutation"/>
                    <field name="expected_arrival_time" readonly="state not in ['draft']" invisible="not snk_is_mutation"/>
                </field>

                <xpath expr="//group[@name='carrier_data']" position="inside">
                    <field name='sale_id' invisible="1"/>
                    <field name='delivery_price' invisible="1"/>
                    <field name='price_rule_id' invisible="1"/>
                    <field name='currency_id' invisible="1"/>
                    <field name='carrier_currency_id' invisible="1"/>

                    <label for="delivery_cost_price"/>
                    <div class="o_row">
                        <field name='delivery_cost_price' force_save="1" widget="monetary" options="{'currency_field': 'carrier_currency_id'}" invisible="not carrier_id"/>
                    </div>
                    <label for="delivery_price"/>
                    <div class="o_row">
                        <field name='delivery_price' force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not carrier_id"/>
                    </div>

                    <div role="alert" class="alert alert-info" invisible="context.get('no_rate') or not delivery_message">
                        <field name="delivery_message" nolabel="1"/>
                    </div>
                    <div role="alert" class="alert alert-danger" invisible="not context.get('no_rate') or not delivery_message">
                        <field name="delivery_message" nolabel="1"/>
                    </div>
                </xpath>
                <xpath expr="//group[@name='carrier_data']/field[@name='delivery_type']" position="after">
                    <field name="snk_bill_ref"/>
                </xpath>

                <xpath expr="//field[@name='date_done']" position="after">
                    <field name="snk_physical_date" invisible="state not in ['assigned','done']"/>
                </xpath>
            </field>
        </record>

        <record id="snk_view_picking_tree_inherit" model="ir.ui.view">
            <field name="model">stock.picking</field>
            <field name="name">snk.view.picking.tree.inherit</field>
            <field name="inherit_id" ref="stock.vpicktree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='scheduled_date']" position="after">
                    <field name="snk_physical_date" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='scheduled_date']" position="replace">
                    <field name="scheduled_date" string="Due Date" optional="show" widget="remaining_days" invisible="state in ('done', 'cancel')" readonly="state in ['cancel', 'done']"/>
                    <field name="scheduled_date" optional="show" readonly="state in ['cancel', 'done']"/>
                </xpath>
                <xpath expr="//field[@name='scheduled_date']" position="before">
                    <field name="snk_create_date" optional="show"/>
                </xpath>
            </field>
        </record> 
    </data>
</odoo>
