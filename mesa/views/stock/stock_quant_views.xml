<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="snk_view_stock_quant_package_inherit" model="ir.ui.view">
            <field name="name">snk.stock.quant.package.inherit</field>
            <field name="model">stock.quant.package</field>
            <field name="inherit_id" ref="stock.view_quant_package_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='package_type_id']" position="after">
                    <field name="sequence_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Inventory > Reporting > Stock (Inventory Report) -->
        <record id="snk_view_stock_product_tree_stock_account_inherit" model="ir.ui.view">
            <field name="name">snk.stock.product.tree.stock.account.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock_account.product_product_stock_tree_inherit_stock_account"/>
            <field name="priority">999</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='avg_cost']" position="replace">
                    <field name="avg_cost" groups="mesa.group_snk_view_cost_price" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='total_value']" position="replace">
                    <field name="total_value" groups="mesa.group_snk_view_cost_price" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Inventory > Reporting > Location (Stock Quant) - Standard view -->
        <!-- <record id="snk_view_stock_quant_tree_inherit" model="ir.ui.view">
            <field name="name">snk.stock.quant.tree.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='value']" position="attributes">
                    <attribute name="groups">mesa.group_snk_view_cost_price</attribute>
                </xpath>
                <xpath expr="//button[@name='action_view_stock_moves']" position="attributes">
                    <attribute name="groups">stock.group_stock_user</attribute>
                </xpath>
            </field>
        </record> -->

        

        <!-- Inventory > Reporting > Location (Stock Quant) - Editable view -->
        <record id="snk_view_stock_quant_tree_editable_inherit" model="ir.ui.view">
            <field name="name">snk.stock.quant.tree.editable.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='value']" position="attributes">
                    <attribute name="groups">mesa.group_snk_view_cost_price</attribute>
                </xpath>
                <xpath expr="//button[@name='action_view_stock_moves']" position="attributes">
                    <attribute name="groups">stock.group_stock_user</attribute>
                </xpath>
            </field>
        </record>
    </data>
    <data noupdate="0">
        <!-- Inventory > Reporting > Location (Stock Quant) - Simple view (Add button) -->
        <record id="snk_view_stock_quant_tree_simple_inherit" model="ir.ui.view">
            <field name="name">snk.stock.quant.tree.simple.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <button name="action_view_stock_moves" string="History" type="object" 
                            class="btn-link" icon="fa-history" groups="stock.group_stock_user"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
