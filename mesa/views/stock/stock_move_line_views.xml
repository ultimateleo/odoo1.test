<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_line_form_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.form.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="snk_grade_id" readonly="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="analytic_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="snk_material_code"/>
                </xpath>
                <xpath expr="//field[@name='create_uid']" position="after">
                    <field name="carrier_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="event_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="snk_notes"/>
                </xpath>
            </field>
        </record>


        <record id="view_move_line_tree_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.list.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <!-- Sembunyikan Effective Date, tampilkan Scheduled Date -->
         
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="snk_grade_id" readonly="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="analytic_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//field[@name='location_id']" position="before">
                    <field name="carrier_id" readonly="1" optional="hide" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="event_ids" readonly="1" optional="hide" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//field[@name='reference']" position="before">
                    <field name="scheduled_date" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='reference']" position="after">
                    <field name="picking_type_id" optional="hide"/>
                    <field name="origin" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="stock_move_line_view_search_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.search.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="analytic_id"/>
                    <field name="carrier_id"/>
                    <field name="event_ids"/>
                </xpath>
                <xpath expr="//filter[@name='inventory']" position="after">
                    <separator/>
                    <filter string="Has Carrier" name="has_carrier_id" domain="[('carrier_id','!=',False)]" />
                </xpath>
                <xpath expr="//group" position="inside">
                    <filter string="Brand" name="by_analytic_id" context="{'group_by':'analytic_id'}"/>
                    <filter string="Events" name="by_event_ids" context="{'group_by':'event_ids'}"/>
                </xpath>
            </field>
        </record>

        <record id="action_update_scheduled" model="ir.actions.server">
            <field name="name">Update Scheduled Date</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="binding_model_id" ref="stock.model_stock_move_line"/>
            <field name="binding_view_types">list,form</field>
            <field name="binding_type">action</field>
            <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
            <field name="state">code</field>
            <field name="code">
                action = records.update_scheduled_date()
            </field>
        </record>
    </data>
</odoo>