<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snk_site_grade_list_view" model="ir.ui.view">
            <field name="name">snk.site.grade.list.view</field>
            <field name="model">snk.site.grade</field>
            <field name="arch" type="xml">
                <list string="Grades" editable="bottom">
                    <field name="snk_name"/>
                    <field name="snk_description"/>
                </list>
            </field>
        </record>

         <record id="snk_site_grade_list_view_search" model="ir.ui.view">
            <field name="name">snk.site.grade.list.view</field>
            <field name="model">snk.site.grade</field>
            <field name="arch" type="xml">
                <search string="Grades">
                    <field name="snk_name"/>
                    <filter string="Name" name="snk_name" context="{'group_by':'snk_name'}"/>
                </search>
            </field>
        </record>

        <record id="action_snk_site_grade" model="ir.actions.act_window">
            <field name="name">Grades</field>
            <field name="res_model">snk.site.grade</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="snk_site_grade_list_view"/>
        </record>

        <menuitem id="menu_snk_site_grade" name="Grades" parent="menu_snk_site_root" action="action_snk_site_grade" sequence="1"/>
    </data>
</odoo>
