<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">view.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">

                <xpath expr="//field[@name='purchase_vendor_bill_id']" position="after">
                    <field name="snk_po_number" invisible="move_type != 'in_invoice'" />
                </xpath>
                <xpath expr="//list/field[@name='name']" position="after">
                    <field name="snk_material_code" />
                    <field name="snk_description" />
                    <field name="snk_grade_id" readonly="1" optional="hide" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//group[@id='header_right_group']//field[@name='date']" position="attributes">
                    <attribute name="invisible">move_type not in ('entry', 'in_invoice', 'in_refund', 'in_receipt', 'out_invoice', 'out_refund', 'out_receipt')</attribute>
                    <attribute name="readonly">state != 'draft'</attribute>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="replace">
                    <field name="partner_id"
                        widget="res_partner_many2one"
                        nolabel="1"
                        domain="[('company_id', 'in', (False, company_id)), ('supplier_rank','&gt;', 0)]"
                        context="{
                             'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                             'show_address': 1,
                             'default_is_company': True,
                             'show_vat': True
                         }"
                        options='{"no_quick_create": True}'
                        placeholder="Search a name or Tax ID..."
                        invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                        readonly="state != 'draft'" />

                    <field name="partner_id"
                        widget="res_partner_many2one"
                        nolabel="1"
                        domain="[('company_id', 'in', (False, company_id)), ('customer_rank','&gt;', 0)]"
                        context="{
                             'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                             'show_address': 1,
                             'default_is_company': True,
                             'show_vat': True
                         }"
                        options='{"no_quick_create": True}'
                        placeholder="Search a name or Tax ID..."
                        invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"
                        readonly="state != 'draft'" />
                </xpath>
            </field>
        </record>


        <record id="snk_account_move_efaktur_form_view" model="ir.ui.view">
            <field name="name">account.move.efaktur.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="l10n_id_efaktur.account_move_efaktur_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='l10n_id_tax_number']" position="before">
                    <field name="snk_is_not_efaktur" invisible="1" />
                </xpath>
                <xpath expr="//field[@name='l10n_id_tax_number']" position="attributes">
                    <attribute name="readonly">not snk_is_not_efaktur</attribute>
                </xpath>
                <xpath expr="//button[@name='action_post'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_post'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//header/button[@name='action_post'][2]" position="after">
                    <button name="action_post" string="Post" class="oe_highlight"
                        type="object" groups="account.group_account_invoice" data-hotkey="q"
                        context="{'validate_analytic': True, 'disable_abnormal_invoice_detection': False}"
                        invisible="hide_post_button or move_type != 'entry'" />
                    <button name="action_post" string="Confirm" class="oe_highlight"
                        type="object" groups="account.group_account_invoice" data-hotkey="q"
                        context="{'validate_analytic': True, 'disable_abnormal_invoice_detection': False}"
                        invisible="hide_post_button or move_type == 'entry' or display_inactive_currency_warning or l10n_id_tax_number == False" />
                    <button name="action_post" string="Confirm" class="oe_highlight"
                        type="object" groups="account.group_account_invoice" data-hotkey="q"
                        context="{'validate_analytic': True, 'disable_abnormal_invoice_detection': False}"
                        confirm="Tax Number is empty. Are you sure to confirm this record?"
                        invisible="hide_post_button or move_type == 'entry' or display_inactive_currency_warning or l10n_id_tax_number != False" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>