<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snk_purchase_type_view_form" model="ir.ui.view">
            <field name="name">snk.purchase.type.view.form</field>
            <field name="model">snk.purchase.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="snk_name"/>
                            <h1>
                                <field name="snk_name" placeholder="e.g. Type" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="snk_code"/>
                                <field name="snk_description"/>
                                <field name="snk_sequence_id"/>
                                <field name="snk_type"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--list view-->
        <record id="snk_purchase_type_view_list" model="ir.ui.view">
            <field name="name">snk.purchase.type.view.list</field>
            <field name="model">snk.purchase.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="snk_name"/>
                    <field name="snk_code"/>
                    <field name="snk_description"/>
                    <field name="snk_sequence_id"/>
                </list>
            </field>
        </record>

        <!--search view-->
        <record id="snk_purchase_type_view_search" model="ir.ui.view">
            <field name="name">snk.purchase.type.view_search</field>
            <field name="model">snk.purchase.type</field>
            <field name="arch" type="xml">
                <search string="Purchase Type">
                    <field name="snk_name"/>
                    <field name="snk_description"/>
                    <field name="snk_code"/>
                </search>
            </field>
        </record>

        <!--menu action-->
        <record id="snk_purchase_type_view_action" model="ir.actions.act_window">
            <field name="name">Purchase Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">snk.purchase.type</field>
            <field name="path">snk-purchase-type</field>
            <field name="view_mode">list,form</field>
        </record>

        <!--menus-->
        <menuitem id="snk_purchase_type_menu" action="snk_purchase_type_view_action" parent="purchase.menu_purchase_config" sequence="2"/>
    </data>
</odoo>
