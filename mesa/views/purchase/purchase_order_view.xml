<odoo>
    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="name">purchase.order.select - purchase_tier_validation</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter" />
        <field name="arch" type="xml">
            <!-- Add search by PO Number field -->
            <search position="inside">
                <field name="snk_po_number" string="PO Number"
                    filter_domain="[('snk_po_number', 'ilike', self)]" />
            </search>

            <filter name="order_date" position="after">
                <separator />
                <filter
                    name="needs_review"
                    string="Needs my Review"
                    domain="[('reviewer_ids','in',uid), ('state', 'not in', ['done', 'cancel','to approve'])]"
                    help="My Purchases to review"
                />
                <filter
                    name="tier_validated"
                    string="Validated"
                    domain="[('validated', '=', True)]"
                    help="POs validated and ready to be confirmed"
                />
            </filter>
        </field>
    </record>
    <record id="snk_view_purchase_order_search" model="ir.ui.view">
        <field name="name">snk.purchase.order.search</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search" />
        <field name="arch" type="xml">
            <search position="inside">
                <field name="snk_po_number" string="PO Number"
                    filter_domain="[('snk_po_number', 'ilike', self)]" />
            </search>
        </field>
    </record>
    <record id="purchase_order_kpis_tree" model="ir.ui.view">
        <field name="name">purchase.order.inherit.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree" />
        <field name="arch" type="xml">
            <list position="inside">
                <field
                    name="validation_status"
                    widget="badge"
                    optional="hide"
                    decoration-info="validation_status == 'pending'"
                    decoration-danger="validation_status == 'rejected'"
                    decoration-success="validation_status == 'validated'"
                />

            </list>
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="snk_po_number" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="snk_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">snk.purchase.order.form.view.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">

            <!-- <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath> -->

            <xpath expr="//field[@name='requisition_id']" position="after">
                <field name="snk_purchase_type_id" required="1"
                    domain="[('snk_type', '=', 'order')]" />
                <field name="snk_po_number" readonly="1" />
            </xpath>
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="snk_description" optional="show" readonly="state in ('done', 'cancel')" />
                <field name="snk_material_code" optional="show"
                    readonly="state in ('done', 'cancel')" />
            </xpath>

            <!-- <xpath expr="//field[@name ='product_qty']" position="attributes">
                <attribute name="readonly">[('state', 'in', ('done','cancel'))]</attribute>
            </xpath>
            <xpath expr="//field[@name ='price_unit']" position="attributes">
                <attribute name="readonly">[('state', 'in', ('done','cancel'))]</attribute>
            </xpath> -->


            <!--            <xpath expr="//field[@name='order_line']" position="after">-->
            <!--                <button string="Select multiple product" type="object"
            name="snk_action_multi_product" class="btn-primary"/>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                position="before">
                <field name="product_product_id" />
                <field name="template_code" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="before">
                <field name="snk_site_id" required="1" />
                <field name="snk_site_name" />
                <field name="snk_site_warehouse_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="domain">[('code','=','incoming'), ('warehouse_id', '=',
                    snk_site_warehouse_id)] if snk_site_id else [('code','=','incoming'),
                    '|',('warehouse_id', '=', False), ('warehouse_id.company_id', '=', company_id)]</attribute>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="analytic_account_ids" required="1" widget="many2many_tags" />
                <field name="snk_approve" />
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                position="after">
                <field name="analytic_account_id"
                    domain="[('id', 'in', parent.analytic_account_ids)]"
                    readonly="1" />
            </xpath>

            <xpath expr="//list/field[@name='product_uom'][2]" position="after">
                <field name="snk_remaining_order" readonly="0" />
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('supplier_rank','>', 0)]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                position="attributes">
                <attribute name="domain">[('analytic_id', 'in', parent.analytic_account_ids)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Report Action -->


    <record id="snk_purchase_order_tree_inherit" model="ir.ui.view">
        <field name="name">snk.purchase.order.tree.view.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="snk_po_number" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="action_update_source_document_po" model="ir.actions.server">
        <field name="name">Update Source Document</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_update_source_document()
        </field>
    </record>
</odoo>
