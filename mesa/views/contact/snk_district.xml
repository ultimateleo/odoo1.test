<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snk_district_list_view" model="ir.ui.view">
            <field name="name">snk.district.list.view</field>
            <field name="model">snk.district</field>
            <field name="arch" type="xml">
                <list string="District" editable="bottom">
                    <field name="snk_name"/>
                </list>
            </field>
        </record>


         <record id="snk_district_list_view_search" model="ir.ui.view">
            <field name="name">snk.district.list</field>
            <field name="model">snk.district</field>
            <field name="arch" type="xml">
                <search string="District">
                    <field name="snk_name"/>
                    <filter string="Name" name="snk_name" context="{'group_by':'snk_name'}"/>
                </search>
            </field>
        </record>

        <record id="action_snk_district" model="ir.actions.act_window">
            <field name="name">District</field>
            <field name="res_model">snk.district</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="snk_district_list_view"/>
        </record>

        <menuitem id="menu_district" name="District" parent="contacts.menu_partner_category_form" action="action_snk_district" sequence="1"/>
    </data>
</odoo>
