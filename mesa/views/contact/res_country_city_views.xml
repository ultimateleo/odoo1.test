<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_country_city_form" model="ir.ui.view">
            <field name="name">res.country.city.view.form</field>
            <field name="model">res.country.city</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="zip_id"/>
                                <field name="state_id"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!--list view-->
        <record id="res_country_city_view_list" model="ir.ui.view">
            <field name="name">res.country.city.view.list</field>
            <field name="model">res.country.city</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="zip_id"/>
                    <field name="state_id"/>
                </list>
            </field>
        </record>

        <!--search view-->
        <record id="res_country_city_view_search" model="ir.ui.view">
            <field name="name">res.country.city.view_search</field>
            <field name="model">res.country.city</field>
            <field name="arch" type="xml">
                <search string="Cities">
                    <field name="name"/>
                    <field name="zip_id"/>
                    <field name="state_id"/>
<!--                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>-->
                </search>
            </field>
        </record>

        <!--menu action-->
        <record id="res_country_city_view_action" model="ir.actions.act_window">
            <field name="name">Cities</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.country.city</field>
            <field name="path">res-country-city</field>
            <field name="view_mode">list,form</field>
        </record>

        <!--menus-->
        <menuitem id="res_country_city_menu" action="res_country_city_view_action" parent="contacts.menu_localisation" sequence="3"/>
    </data>
</odoo>
