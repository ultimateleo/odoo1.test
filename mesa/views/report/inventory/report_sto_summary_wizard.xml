<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_report_sto_summary_wizard_form" model="ir.ui.view">
        <field name="name">report.sto.summary.wizard.form</field>
        <field name="model">report.sto.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate STO Summary Report">
                <div class="alert alert-info" role="alert" style="margin-bottom: 20px;">
                    <strong>Petunjuk:</strong><br/>
                    Pilih Periode STO Date untuk menarik STO Summary Report.<br/>
                    Report ini menampilkan ringkasan per STO termasuk informasi Receipt, Ekspedisi, dan Akurasi.<br/>
                    <strong>Performa:</strong> Data diambil via SQL langsung — aman untuk data besar.
                </div>
                <group>
                    <group string="Parameters">
                        <label for="date_start" string="Periode STO Date"/>
                        <div class="o_row">
                            <field name="date_start" widget="date"/>
                            <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                            <field name="date_end" widget="date"/>
                        </div>
                        <field name="site_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                        <field name="destination_site_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="Filters (Optional)">
                        <field name="analytic_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                        <field name="carrier_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" string="Generate Report" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_report_sto_summary_wizard" model="ir.actions.act_window">
        <field name="name">STO Summary</field>
        <field name="res_model">report.sto.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
