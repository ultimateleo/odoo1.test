<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View report.mesa.report_mesa_3x18 View List -->
    <record id="view_report_mesa_report_mesa_3x18_list" model="ir.ui.view">
        <field name="name">view.report.mesa.report_mesa_3x18.list</field>
        <field name="model">report.mesa.report_mesa_3x18</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View report.mesa.report_mesa_3x18 form -->
    <record id="view_report_mesa_report_mesa_3x18_form" model="ir.ui.view">
        <field name="name">view.report.mesa.report_mesa_3x18.form</field>
        <field name="model">report.mesa.report_mesa_3x18</field>
        <field name="arch" type="xml">
            <form string="Report Mesa Report_mesa_3x18">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View report.mesa.report_mesa_3x18 search -->
    <record id="view_report_mesa_report_mesa_3x18_search" model="ir.ui.view">
        <field name="name">view.report.mesa.report_mesa_3x18.search</field>
        <field name="model">report.mesa.report_mesa_3x18</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action report.mesa.report_mesa_3x18 -->
    <record id="action_report_mesa_report_mesa_3x18" model="ir.actions.act_window">
        <field name="name">Report Mesa Report_mesa_3x18</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">report.mesa.report_mesa_3x18</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Report Mesa Report_mesa_3x18.
            </p>
        </field>
    </record>

</odoo>
