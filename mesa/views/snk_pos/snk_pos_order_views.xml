                    <button string="Confirm"
                        name="action_remove_orders"
                        type="object"
                        class="btn btn-secondary"
                        display="always"
                        />
                </header>
                <field name="name"/>
                <field name="date_order" optional="show"/>
                <field name="create_date" optional="hide"/>
                <field name="reference" optional="hide"/>
                <field name="snk_site_id" widget="many2one" />
                <field name="snk_site_name" optional="show" />
                <field name="customer_id" widget="many2one" optional="hide" />
                <field name="partner_id" widget="many2one" optional="hide" />
                <field name="warehouse_id" widget="many2one" optional="hide" />
                <field name="company_registry" optional="hide" />
                <field name="company_id" widget="many2one" optional="hide" />
                <field name="product_template_id" widget="many2one" optional="hide" />
                <field name="product_template_ref" optional="hide" />
                <field name="product_id" widget="many2one" optional="hide" />
                <field name="product_variant_ref" optional="hide" />
                <field name="description" optional="hide" />
                <field name="grade_id" widget="many2one" optional="hide" />
                <field name="analytic_account_id" widget="many2one" optional="hide"/>
                <field name="product_uom_qty" optional="hide" sum="Qty"/>
                <field name="currency_id" widget="many2one" optional="hide"/>
                <field name="price_unit" widget="monetary" optional="hide" avg="Price"/>
                <field name="discount_amount" widget="monetary" optional="hide" sum="Discount"/>
                <field name="discount" optional="hide" />
                <field name="tax_id" widget="many2many_tags" optional="hide" />
                <field name="price_tax" widget="monetary" optional="hide"/>
                <field name="project_ids" widget="many2many_tags" optional="hide" />
                <field name="price_total" widget="monetary" optional="hide" sum="Total"/>
                <field name="price_subtotal" widget="monetary" optional="show" sum="Subotal"/>
                <field name="state"
                    decoration-success="state == 'confirmed'"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'close'"
