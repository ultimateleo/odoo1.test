<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="snk_pos_sale_sequence" model="ir.sequence">
            <field name="name">SNK pos Sale Sequence</field>
            <field name="code">snk.pos.sale</field>
            <field name="prefix">SALES/</field>
            <field eval="1" name="number_next" />
            <field eval="1" name="number_increment" />
            <field name="padding">5</field>
        </record>
    
    <record id="snk_pos_sale_view_list" model="ir.ui.view">
        <field name="name">snk.pos.sale.view.list</field>
        <field name="model">snk.pos.sale</field>
        <field name="arch" type="xml">
            <list string="Sales" sample="1" decoration-info="state == 'draft'"
                decoration-muted="state == 'cancel'" duplicate="0">
                <field name="name" />
                <field name="start_date" string="Start Date" optional="show" />
                <field name="end_date" optional="show" />
                <field name="reference" optional="show" />
                <field name="create_uid" optional="hide" />
                <field name="customer_id" widget="many2one" />
                <field name="site_ids" widget="many2many_tags" optional="hide"/>
                <field name="analytic_account_ids" widget="many2many_tags" optional="hide"/>
                <field name="company_id" widget="many2one" optional="hide" />
                <field name="state"
                    decoration-success="state == 'confirmed'"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'close'"
                    decoration-muted="state == 'cancel'"
                    widget="badge" />
                <field name="invoice_status" optional="hide" />
            </list>
        </field>
    </record>
    <record id="snk_pos_sale_view_search" model="ir.ui.view">
        <field name="name">snk.pos.sale.view.search</field>
        <field name="model">snk.pos.sale</field>
        <field name="arch" type="xml">
            <search string="Sales">
                <field name="name" />
                <field name="customer_id" />
                <field name="reference" />
                <field name="analytic_account_ids" />
                <field name="project_ids" />
                <filter string="Archived" name="inactive" domain="[('active','=',False)]" />
                <separator />
                <filter string="Closed" name="close" domain="[('state', '=', 'close')]" />
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]" />
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancel')]" />
                <separator />
                <filter string="Period Date" name="start_date" date="start_date" />
                <group expand="0" string="Group By">
                    <filter string="Sale" name="sale" domain="[]"
                        context="{'group_by': 'name'}" />
                    <filter string="Customer" name="customer" domain="[]"
                        context="{'group_by': 'customer_id'}" />
                    <filter string="Site" name="sites" domain="[]"
                        context="{'group_by': 'site_ids'}" />
                    <filter string="Reference" name="ref" domain="[]"
                        context="{'group_by': 'reference'}" />
                    <filter string="Brands" name="brands_group" domain="[]"
                        context="{'group_by': 'analytic_account_ids'}" />
                    <filter string="Events" name="events_group" domain="[]"
                        context="{'group_by': 'project_ids'}" />
                    <filter string="Period" name="period_month" domain="[]"
                        context="{'group_by': 'start_date'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="snk_pos_sale_view_form" model="ir.ui.view">
        <field name="name">snk.pos.sale.view.form</field>
        <field name="model">snk.pos.sale</field>
        <field name="arch" type="xml">
            <form string="Sales">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="(state != 'draft')" class="oe_highlight" />
                    <button name="action_close" string="Close" type="object"
                        invisible="is_invoiced == True or state != 'confirmed'" />

                    <button name="action_create_invoice_queue" class="oe_highlight" string="Create Invoice" type="object"
                        invisible="(state != 'confirmed') or (invoice_status != 'no')"/>
                    <!-- <button name="test_notification" string="Tes Bus" type="object"/> -->

                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state != 'confirmed'" />
                    <button name="action_reset" string="Reset To Draft" type="object"
                        invisible="(state != 'cancel')" />
                    <button
                        name="action_add_orders"
                        type="object"
                        class="btn btn-primary"
                        string="Add Orders"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_remove_orders"
                        type="object"
                        class="btn btn-secondary"
                        string="Edit Orders"
                        invisible="state != 'draft'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,close" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            >
                            <!-- invisible="not invoice_count" -->
                            <field name="invoice_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Name" />
                        <h1>
                            <div class="d-flex">
                                <field class="text-break" name="name" readonly="1" placeholder="" />
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference" />
                            <field name="start_date" widget="daterange"
                                options="{'end_date_field': 'end_date'}" />
                            <field name="end_date" invisible="True" />
                            <field name="customer_id" widget="many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="site_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="partner_ids" widget="many2many_tags" invisible="True" />
                            <field name="analytic_account_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="project_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="is_invoiced" />
                        </group>
                        <group>
                            <field name="company_id" widget="many2one" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" readonly="1"/>
                            <field name="currency_id" widget="many2one" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="payment_term_id" invisible="not is_invoiced"
                                placeholder="Immediate"
                                options="{'no_open': True, 'no_create': True}" />
                            <field name="journal_id" widget="many2one" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" invisible="not is_invoiced" />
                            <field name="invoice_status" readonly="1" invisible="not is_invoiced"/>
                            <field name="invoice_in_queue"/>
                            <!-- <field name="account_move_id"/> -->
                            <field name="fiscal_position_id" invisible="not is_invoiced"
                                widget="many2one" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="orders">
                            <field name='order_lines'
                                nolabel="1"
                                >
                                <!-- domain="[('sale_id', '=', id)]" -->
                                <list string="Order Lines" limit="20"
                                    editable="top" create="false" delete="false">
                                    <!-- create="False" duplicate="0" -->
                                    <!-- decoration-muted="state == 'cancel'"  -->
                                    <!-- decoration-info="state == 'draft'" -->
                                    <field name="name"/>
                                    <field name="date_order" optional="show"/>
                                    <field name="create_date" optional="hide"/>
                                    <field name="reference" optional="hide"/>
                                    <field name="snk_site_id" widget="many2one" />
                                    <field name="snk_site_name" optional="show" />
                                    <field name="customer_id" widget="many2one" optional="hide" />
                                    <field name="partner_id" widget="many2one" optional="hide" />
                                    <field name="warehouse_id" widget="many2one" optional="hide" />
                                    <field name="company_registry" optional="hide" />
                                    <field name="company_id" widget="many2one" optional="hide" />
                                    <field name="product_template_id" widget="many2one" optional="hide" />
                                    <field name="product_template_ref" optional="hide" />
                                    <field name="product_id" widget="many2one" optional="hide" />
                                    <field name="product_variant_ref" optional="hide" />
                                    <field name="description" optional="hide" />
                                    <field name="grade_id" widget="many2one" optional="hide" />
                                    <field name="analytic_account_id" widget="many2one" optional="hide"/>
                                    <field name="product_uom_qty" optional="hide" sum="Qty"/>
                                    <field name="currency_id" widget="many2one" optional="hide"/>
                                    <field name="price_unit" widget="monetary" optional="hide" avg="Price"/>
                                    <field name="discount_amount" widget="monetary" optional="hide" sum="Discount"/>
                                    <field name="discount" optional="hide" />
                                    <field name="tax_id" widget="many2many_tags" optional="hide" />
                                    <field name="price_tax" widget="monetary" optional="hide"/>
                                    <field name="project_ids" widget="many2many_tags" optional="hide" />
                                    <field name="price_total" widget="monetary" optional="hide" sum="Total"/>
                                    <field name="price_subtotal" widget="monetary" optional="show" sum="Subotal"/>
                                    <field name="state"
                                        decoration-success="state == 'confirmed'"
                                        decoration-info="state == 'draft'"
                                        decoration-primary="state == 'close'"
                                        decoration-muted="state == 'cancel'"
                                        widget="badge" />
                                    <field name="invoice_status" optional="hide" />
                                    <field name="delivery_status" optional="hide" />
                                    <!-- <control>
                                    <button
                                        name="action_remove_orders"
                                        type="object"
                                        string="Edit Orders"
                                        class="fa-link btn-sm"
                                        invisible="state != 'confirmed'"
                                    />
                                    </control> -->
                                    <!-- <button name="action_delete_order_line"
                                        type="button"
                                        class="oe_stat_button"
                                        icon="fa-trash"
                                    /> -->
                                        <!-- attrs="{'invisible': [('state', 'in', ['close', 'cancel'])]}" -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group colspan="4">
                            <field colspan="2" name="note" nolabel="1"
                                placeholder="Terms and conditions..." />
                        </group>
                        <group class="oe_subtotal_footer" colspan="2" name="sale_total">
                            <field name="tax_totals" widget="account-tax-totals-field" nolabel="1"
                                colspan="2" readonly="1" />
                        </group>
                        <div class="clearfix" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="snk_pos_sale_action" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">snk.pos.sale</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="snk_pos_sale_view_list" />
        <field name="search_view_id" ref="snk_pos_sale_view_search" />
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No Sale for display
            </p>
            <p>
                The Sale will be displayed here.
            </p>
        </field>
    </record>

    <record id="snk_recompute_amounts_pos_sale" model="ir.actions.server">
        <field name="name">Recompute Amounts</field>
        <field name="model_id" ref="model_snk_pos_sale"/>
        <field name="binding_model_id" ref="model_snk_pos_sale"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">
            action = records.action_enqueue_recompute_amounts()
        </field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <menuitem
        id="snk_pos_sale_order_menu"
        parent="snk_pos_order_menu"
        name="Sales"
        action="snk_pos_sale_action"
        sequence="2" />
    </data>
</odoo>