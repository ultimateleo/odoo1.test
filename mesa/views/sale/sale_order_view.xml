<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--form view-->
        <record id="sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="before">
                    <field name="snk_site_id" required="1"/>
                    <field name="snk_site_name"/>
                </field>
                <field name="payment_term_id" position="before">
                    <field name="analytic_account_ids" required="1" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </field>
                <xpath expr="//field[@name='project_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <field name="client_order_ref" position="after">
                    <field name="event_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                </field>
                <field name="picking_policy" position="after">
                    <field name="carrier_id" domain="['|', ('city_ids', 'in', city_id),('city_ids', '=', False)]"
                           string="Carrier" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="city_id" options="{'no_create': True, 'no_create_edit': True}"/>
                </field>
                <xpath expr="//page[@name='other_information']/group/group[@name='sale_shipping']" position="inside">
                    <field name='delivery_price' invisible="1"/>
                    <field name='price_rule_id' invisible="1"/>
                    <field name='carrier_currency_id' invisible="1"/>

                    <label for="delivery_cost_price"/>
                    <div class="o_row">
                        <field name='delivery_cost_price' force_save="1" widget="monetary" options="{'currency_field': 'carrier_currency_id'}" invisible="not carrier_id"/>
                    </div>
                    <label for="delivery_price"/>
                    <div class="o_row">
                        <field name='delivery_price' force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not carrier_id"/>
                    </div>

                    <div role="alert" class="alert alert-info" invisible="context.get('no_rate') or not delivery_message">
                        <field name="delivery_message" nolabel="1"/>
                    </div>
                    <div role="alert" class="alert alert-danger" invisible="not context.get('no_rate') or not delivery_message">
                        <field name="delivery_message" nolabel="1"/>
                    </div>
                </xpath>


                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='product_template_id']" position="attributes">
                    <attribute name="domain">[('sale_ok', '=', True),('analytic_id', 'in', parent.analytic_account_ids)]</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                    <attribute name="domain">[('sale_ok', '=', True),('analytic_id', 'in', parent.analytic_account_ids)]</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                    <field name="snk_grade_id" options="{'no_open': True}" optional="hide"/>
                    <field name="analytic_id" options="{'no_open': True}" optional="hide"/>
                    <field name="event_ids" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" widget="many2many_tags"
                           domain="[('id', 'in', parent.event_ids)] if parent.event_ids else [('account_id', '!=', False)]" optional="hide"/>
                    <field name="snk_discount_amount" string="Disc. Amount" optional="show"/>

                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="domain">[('customer_rank','>', 0)]</attribute>
                </xpath>
            </field>
        </record>

        <!--list view-->
        <record id="sale_order_tree_inherit" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="analytic_account_ids" widget="many2many_tags" optional="hide"/>
                    <field name="event_ids" widget="many2many_tags" optional="hide"/>
                    <field name="carrier_id" string="Carrier" optional="hide"/>
                </field>
                <xpath expr="//list" position="inside">
                    <header>
                        <button string="Confirm" name="snk_action_confirm" type="object" class="oe_highlight"/>
                        <button string="Upload Order ID" name="snk_action_upload_order_id" type="object" class="btn btn-secondary" display="always"/>
                        <button string="Auto Fill Brands" name="action_auto_fill_brands" type="object" class="btn btn-secondary" display="always" groups="base.group_system"/>
                    </header>
                </xpath>
            </field>
        </record>

        <!--search view-->
        <record id="sale_order_view_search_inherit_quotation_inherit" model="ir.ui.view">
            <field name="name">sale.order.view.search.inherit.quotation.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='campaign_id']" position="after">
                    <field name="analytic_account_ids"/>
                    <field name="carrier_id" string="Carrier"/>
                    <field name="event_ids"/>
                </xpath>
                <xpath expr="//filter[@name='my_quotation']" position="after">
                    <separator/>
                    <filter string="Has Carrier" name="has_carrier_id" domain="[('carrier_id','!=',False)]" />
                </xpath>
                <xpath expr="//filter[@name='order_month']" position="after">
                    <separator/>
                    <filter name="brands" string="Brands" domain="[]" context="{'group_by': 'analytic_account_ids'}"/>
                    <filter name="carriers" string="Carrier" domain="[]" context="{'group_by': 'carrier_id'}"/>
                    <filter name="events" string="Events" domain="[]" context="{'group_by': 'event_ids'}"/>
                </xpath>
            </field>
        </record>

        <!--action servers-->
        <record id="snk_action_bulk_confirm" model="ir.actions.server">
            <field name="name">Confirm</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.snk_action_bulk_confirm()</field>
        </record>

        <record id="snk_action_bulk_return" model="ir.actions.server">
            <field name="name">Return Delivery</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.snk_action_bulk_return()</field>
            <field name="confirmation_active" eval="True"/>
            <field name="confirmation">This action will return all quantity of each delivery.
Are you sure will perform this action?</field>
        </record>

        <record id="snk_update_taxes_sales" model="ir.actions.server">
            <field name="name">Update Taxes</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="binding_view_types">list</field>
            <field name="code">
                action = records.action_enqueue_update_taxes()
            </field>
            <!-- <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/> -->
        </record>

    </data>

</odoo>
