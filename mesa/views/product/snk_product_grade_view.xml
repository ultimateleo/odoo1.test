<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snk_product_grade_view_form" model="ir.ui.view">
            <field name="name">snk.product.grade.view.form</field>
            <field name="model">snk.product.grade</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="active" invisible="1"/>
                                <field name="snk_name"/>
                                <field name="snk_description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--list view-->
        <record id="snk_product_grade_view_list" model="ir.ui.view">
            <field name="name">snk.product.grade.view.list</field>
            <field name="model">snk.product.grade</field>
            <field name="arch" type="xml">
                <list>
                    <field name="snk_name"/>
                    <field name="snk_description"/>
                </list>
            </field>
        </record>

        <!--search view-->
        <record id="snk_product_grade_view_search" model="ir.ui.view">
            <field name="name">snk.product.grade.view_search</field>
            <field name="model">snk.product.grade</field>
            <field name="arch" type="xml">
                <search string="Product Grade">
                    <field name="snk_name"/>
                    <field name="snk_description"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!--menu action-->
        <record id="snk_product_grade_view_action" model="ir.actions.act_window">
            <field name="name">Product Grade</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">snk.product.grade</field>
            <field name="path">snk-product-grade</field>
            <field name="view_mode">list,form</field>
        </record>

        <!--menus-->
        <menuitem id="snk_product_grade_menu" action="snk_product_grade_view_action" parent="stock.menu_product_in_config_stock" sequence="3"/>
    </data>
</odoo>
