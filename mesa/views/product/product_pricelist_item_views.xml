<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="snk_action_xml_pricelist_item" model="ir.actions.server">
            <field name="name">Generate XML Pricelist Item</field>
            <field name="binding_model_id" ref="product.model_product_pricelist_item"/>
            <field name="model_id" ref="product.model_product_pricelist_item"/>
            <field name='groups_id' eval="[(4, ref('base.group_system'))]"/>
            <field name="binding_type">action</field>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">records.snk_action_xml_site()</field>
        </record>
        <record id="product_pricelist_item_search_inherit_active" model="ir.ui.view">
            <field name="name">product.pricelist.item.search.inherit.active</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='visible']" position="after">
                    <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>