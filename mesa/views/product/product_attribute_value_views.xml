<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snk_product_attribute_value_view_list_inherit" model="ir.ui.view">
            <field name="name">snk.product.attribute.value.list.view.inherit</field>
            <field name="model">product.attribute.value</field>
            <field name="arch" type="xml">
                <list string="Attribute Values">
                    <field name="name"/>
                    <field name="snk_description"/>
                    <field name="snk_is_synch"/>
                </list>
            </field>
        </record>

        <record id="snk_action_xml_attribute_value" model="ir.actions.server">
            <field name="name">Generate XML Attributes</field>
            <field name="binding_model_id" ref="product.model_product_attribute_value"/>
            <field name="model_id" ref="product.model_product_attribute_value"/>
            <field name='groups_id' eval="[(4, ref('base.group_system'))]"/>
            <field name="binding_type">action</field>
            <field name="binding_view_types">list, form</field>
            <field name="state">code</field>
            <field name="code">records.snk_action_xml_attribute_value()</field>
        </record>

        <record id="snk_action_product_attribute_value" model="ir.actions.act_window">
            <field name="name">Attribute Values</field>
            <field name="res_model">product.attribute.value</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new product attribute value
                </p>
            </field>
        </record>

        <menuitem id="menu_snk_attribute_value" action="snk_action_product_attribute_value"
                  parent="stock.menu_product_in_config_stock" sequence="5"/>
    </data>
</odoo>
