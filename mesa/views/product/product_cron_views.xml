<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_fifo_vacuum_global" model="ir.cron">
            <field name="name">Product: FIFO Vacuum (Global Multi-Company)</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_fifo_vacuum(limit=100)</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="priority">5</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
