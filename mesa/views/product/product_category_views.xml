<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="snk_product_category_view_form_inherit" model="ir.ui.view">
            <field name="name">snk.product.category.form.view.inherit</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <button name="snk_action_xml_categories" string="Generate XML Category" type="object"
                            invisible="(id == False)" />
                        <button name="snk_action_xml_brand" string="Generate XML Brand" type="object"
                            invisible="(id == False)" />
                    </header>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="snk_description"/>
                </xpath>
            </field>
        </record>

        <record id="snk_product_category_view_list_inherit" model="ir.ui.view">
            <field name="name">snk.product.category.list.view.inherit</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_list_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='display_name']" position="after">
                    <field name="snk_description"/>
                </xpath>
            </field>
        </record>

        <record id="snk_product_category_view_search_inherit" model="ir.ui.view">
            <field name="name">snk.product.category.search.view.inherit</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="snk_description"/>
                </xpath>
            </field>
        </record>

        <record id="snk_action_xml_brand" model="ir.actions.server">
            <field name="name">Generate XML Brand</field>
            <field name="model_id" ref="product.model_product_category"/>
            <field name="binding_model_id" ref="product.model_product_category"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.snk_action_xml_brand()</field>
        </record>

        <record id="snk_action_xml_categories" model="ir.actions.server">
            <field name="name">Generate XML Category</field>
            <field name="model_id" ref="product.model_product_category"/>
            <field name="binding_model_id" ref="product.model_product_category"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.snk_action_xml_categories()</field>
        </record>
    </data>
</odoo>
