<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product label layout form view -->
    <record id="product_label_layout_form_inherit_mesa" model="ir.ui.view">
        <field name="name">product.label.layout.form.mesa</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='extra_html']" position="attributes">
                <attribute name="invisible">not (print_format == '2x7xprice' or print_format ==
                    '3x18xsku')</attribute>
            </xpath>

        </field>
    </record>

</odoo>