<odoo>
    <record id="view_product_stock_multi_select_wizard_form" model="ir.ui.view">
        <field name="name">product.stock.multi.select.wizard.form</field>
        <field name="model">product.stock.multi.select.wizard</field>
        <field name="arch" type="xml">
            <form string="Pilih Banyak Produk">
                <group>
                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Select" type="object" name="action_add_products" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
