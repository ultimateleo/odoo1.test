<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_delivery_slip_wizard" model="ir.actions.act_window">
            <field name="name">Delivery Slip Wizard</field>
            <field name="res_model">delivery.slip.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <record id="action_open_delivery_slip_wizard" model="ir.actions.server">
            <field name="name">Delivery Slip Wizard</field>
            <field name="model_id" ref="stock.model_stock_picking" />
            <field name="binding_model_id" ref="stock.model_stock_picking" />
            <field name="binding_view_types">list,form</field>
            <field name="binding_type">report</field> <!-- penting agar muncul di menu Print -->
            <field name="state">code</field>
            <field name="code">
                action = {
                "type": "ir.actions.act_window",
                "res_model": "delivery.slip.wizard",
                "view_mode": "form",
                "target": "new",
                "context": {"active_ids": records.ids},
                }
            </field>
        </record>

        <record id="view_delivery_slip_wizard_form" model="ir.ui.view">
            <field name="name">delivery.slip.wizard.form</field>
            <field name="model">delivery.slip.wizard</field>
            <field name="arch" type="xml">
                <form string="Choose Delivery Slip Layout">
                    <group>
                        <group>
                            <field name="slip_format" widget="radio" /> <!-- pilihan slip -->
                        </group>
                        <group>
                            <field name="pricelist_id" invisible="slip_format not in ['with_price', 'with_price_v2', 'mutasi', 'sto', 'sto_v2']"/> <!-- Pricelist -->
                        </group>
                    </group>
                    <footer>
                        <button string="Confirm" type="object" name="action_print_report"
                            class="btn-primary" />
                        <button string="Discard" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>


    </data>

</odoo>