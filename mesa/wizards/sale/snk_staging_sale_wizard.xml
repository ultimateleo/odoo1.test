<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_snk_staging_sale_wizard_form" model="ir.ui.view">
            <field name="name">snk.staging.sale.wizard.form</field>
            <field name="model">snk.staging.sale.wizard</field>
            <field name="arch" type="xml">
                <form string="Upload Order ID">
                    <group>
                        <field name="file" filename="filename" nolabel="1" string="Import"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" class="btn btn-primary" type="object"/>
                        <button string="Discard" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>