<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_snk_sale_order_filter_form" model="ir.ui.view">
            <field name="name">snk.sale.order.filter.form</field>
            <field name="model">snk.sale.order.filter</field>
            <field name="arch" type="xml">
                <form string="Upload Order ID">
                    <group>
<!--                        <field name="upload_file" filename="file_name" nolabel="1" string="Import"/>-->
                        <field name="file_name" invisible="not line_ids" nolabel="1" readonly="1"/>
                    </group>
                    <group>
                        <field name="line_ids" context="{'import_enabled': True}" nolabel="1">
                            <list editable="bottom" create="0" delete="0" edit="0">
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <field name="upload_file" filename="file_name" nolabel="1" string="Import" invisible="line_ids"/>
                        <field name="file_name" invisible="1"/>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="not line_ids"/>
                        <button string="Discard" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>