        <!-- ================================================================== -->
        <!-- FIXED BATCH MRP CRON JOBS                                         -->
        <!-- ================================================================== -->

        <!-- Main Fixed Batch Cron: Runs every 5 minutes, processes 10 sites -->
        <record id="ir_cron_mrp_fixed_batch" model="ir.cron">
            <field name="name">MRP Fixed Batch Processor (10 Sites per Run)</field>
            <field name="model_id" ref="model_snk_order_point"/>
            <field name="state">code</field>
            <field name="code">model.cron_mrp_schedule_fixed_batch()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Daily Reset Cron: Reset processing status at midnight -->
        <record id="ir_cron_mrp_daily_reset" model="ir.cron">
            <field name="name">MRP Daily Reset (Midnight)</field>
            <field name="model_id" ref="model_snk_stock_schedule"/>
            <field name="state">code</field>
            <field name="code">model.reset_daily_processing_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
            <field name="priority">1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=0, minute=0, second=0)"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Stuck Schedule Checker: Check for stuck processing every 30 minutes -->
        <record id="ir_cron_mrp_stuck_checker" model="ir.cron">
            <field name="name">MRP Stuck Schedule Checker</field>
            <field name="model_id" ref="model_snk_stock_schedule"/>
            <field name="state">code</field>
            <field name="code">model.get_stuck_processing_schedules()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
            <field name="priority">8</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

